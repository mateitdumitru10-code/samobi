# Copiaza in apps/api/.env si completeaza cu valorile din
# Supabase Dashboard -> Project Settings -> API / Database.
# Fisierul .env este in .gitignore. Nu-l comite niciodata.

NODE_ENV=development
PORT=3000

# --- Conexiuni Postgres -------------------------------------------------
# Doua conexiuni diferite catre ACEEASI baza. Confundarea lor e cea mai
# frecventa eroare cu Supabase.
#
# DATABASE_URL = pooler, mod TRANZACTIE (port 6543).
#   Folosit de API la runtime. Suporta multe conexiuni scurte.
#   Nu suporta prepared statements -> in postgres.js se pune `prepare: false`.
#
# DIRECT_URL = mod SESIUNE (port 5432).
#   Folosit de drizzle-kit si de migrari. DDL rulat prin poolerul in mod
#   tranzactie esueaza in moduri confuze.
#
# ATENTIE la host: "Direct connection" din dashboard (db.<ref>.supabase.co)
# rezolva DOAR pe IPv6. De pe o retea IPv4 da ENOTFOUND. Foloseste hostul de
# pooler si pentru DIRECT_URL, cu portul 5432 -- acela e "Session pooler".
# Prefixul difera intre proiecte: aws-0, aws-1 etc. Copiaza-l din dashboard.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PAROLA@aws-1-REGIUNE.pooler.supabase.com:6543/postgres
DIRECT_URL=postgresql://postgres.PROJECT_REF:PAROLA@aws-1-REGIUNE.pooler.supabase.com:5432/postgres

# --- Supabase -----------------------------------------------------------
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=

# ATENTIE: ocoleste complet RLS. Este echivalentul unei parole de admin pe
# toata baza de date. Traieste EXCLUSIV aici, in apps/api.
# Daca ajunge in apps/web sau intr-o variabila cu prefix VITE_, este o bresa.
SUPABASE_SERVICE_ROLE_KEY=

# --- CORS ---------------------------------------------------------------
# Originile care pot apela API-ul, separate prin virgula.
WEB_ORIGIN=http://localhost:5173
