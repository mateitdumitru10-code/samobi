{
  "name": "@samobi/shared",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./db": {
      "types": "./dist/db/schema.d.ts",
      "development": "./src/db/schema.ts",
      "default": "./dist/db/schema.js"
    },
    "./calcul": {
      "types": "./dist/calcul/index.d.ts",
      "development": "./src/calcul/index.ts",
      "default": "./dist/calcul/index.js"
    },
    "./scheme": {
      "types": "./dist/scheme/index.d.ts",
      "development": "./src/scheme/index.ts",
      "default": "./dist/scheme/index.js"
    },
    "./nomenclator": {
      "types": "./dist/nomenclator/index.d.ts",
      "development": "./src/nomenclator/index.ts",
      "default": "./dist/nomenclator/index.js"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "decimal.js": "^10.6.0",
    "drizzle-orm": "^0.44.7",
    "expr-eval": "^2.0.2",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts"
}
