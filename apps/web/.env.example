# Copiaza in apps/web/.env
#
# Tot ce are prefix VITE_ ajunge in bundle-ul trimis catre browser. Este
# public prin definitie. Anon key-ul este proiectat sa fie public; el da
# acces doar prin RLS si serveste exclusiv la autentificare.
#
# SUPABASE_SERVICE_ROLE_KEY NU are ce cauta in acest fisier.

VITE_SUPABASE_URL=https://PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=
VITE_API_URL=http://localhost:3000
